# ---------------------------------------------------------------------------
# Partner Admin Panel — development environment
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ENV=development
NEXT_PUBLIC_APP_NAME=Partner Portal
NEXT_PUBLIC_APP_TAGLINE=Swipeo tenant backoffice

# Tenant identity shown in the top bar
NEXT_PUBLIC_TENANT_NAME=Travls Live
NEXT_PUBLIC_TENANT_EMAIL=service@travls.io
NEXT_PUBLIC_TENANT_MODE=live

# Backoffice API
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1
NEXT_PUBLIC_API_TIMEOUT=30000

# Feature flags
NEXT_PUBLIC_ENABLE_MOCK_DATA=true
NEXT_PUBLIC_ENABLE_DARK_MODE=true
